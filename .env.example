# The coach needs one credential. Everything else — the engine, move legality,
# evaluations, the severity classification and concept retrieval — runs with no
# key and no external service.
#
# Get a key at https://aistudio.google.com/apikey. Gemini 3.5 Flash-Lite (the
# default) and 3.5 Flash (used only for "deep" explanations) are both free-tier
# models, so this costs nothing to run. Note that Google's free plan uses your
# content to improve its products; a paid plan does not.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Overrides the per-verbosity default (gemini-3.5-flash-lite, or
# gemini-3.5-flash for "deep"). Bare model IDs only — no `provider/` prefix,
# because this talks to the Gemini API directly rather than through a gateway.
# COACH_MODEL=gemini-3.8-flash

# ── Accounts (multiplayer only) ───────────────────────────────────────────────
# Provisioned by `vercel integration add clerk`, then pulled with
# `vercel env pull`. Single player needs neither of these: signing in is only
# required to play another person, and every engine game works signed out.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk user ID allowed to receive live hint and coach controls in online games.
# Leave unset to disable this developer-only capability everywhere.
DEVELOPER_CLERK_USER_ID=

# ── Multiplayer ───────────────────────────────────────────────────────────────
# Postgres holds the games; it is the authority on every online move, clock and
# result. Provisioned by `vercel integration add neon`, then `vercel env pull`.
# DATABASE_URL is the pooled endpoint the app uses; the unpooled one is for
# migrations, which need a real session (`pnpm db:migrate`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Redis is only the doorbell: it carries "game X changed, sequence N" between
# function instances so each player's event stream wakes up. The moves themselves
# always come from Postgres, so a dropped message costs a round trip rather than a
# move — and with no REDIS_URL at all, games still complete on the heartbeat alone.
REDIS_URL=
