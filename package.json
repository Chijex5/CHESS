{
  "name": "ai-chess-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-engine.mjs && next dev",
    "build": "node scripts/copy-engine.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "engine": "node scripts/copy-engine.mjs",
    "concepts": "node scripts/check-concepts.mjs",
    "verify": "node scripts/check-concepts.mjs && tsc --noEmit && eslint && vitest run && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.63",
    "@clerk/nextjs": "^7.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.92",
    "chess.js": "1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
